# Variables del entorno de TESTING. Copiá este archivo a .env.test (no se sube a Git).
# El nombre de la base TIENE que contener "test": tests/setup.js se niega a correr contra cualquier otra, porque al terminar la suite borra toda la base.
MONGODB_URI=mongodb://localhost:27017/shipnow-test
JWT_SECRET=test_secret

# NODE_ENV=test lo define el script "npm test" (cross-env); se deja acá solo como referencia.
NODE_ENV=test

# Opcional. Los tests no necesitan PORT porque Supertest no abre ningún puerto.
# LOG_LEVEL=debug
